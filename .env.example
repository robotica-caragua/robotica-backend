# Node.js 24 / MySQL ou MariaDB. Não versione o arquivo .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/robotica"

# Gere um valor aleatório com pelo menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Opcionais para login Google; ambos são necessários para /auth/google.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=

# URL do frontend que apresenta a tela de redefinição de senha.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@robotica.local
# Sem SMTP em desenvolvimento, os links ficam em .local/mail/ (não versionado).
# Em produção, configure SMTP para recuperação de senha.
